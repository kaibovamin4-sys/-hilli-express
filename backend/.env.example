HOST=0.0.0.0
PORT=8080
DATABASE_PATH=./aua.db
USE_MOCK=true
MOCK_INTERVAL_MS=30000
# 7 days matches the past window the forecast model pulls from Open-Meteo.
MOCK_SEED_DAYS=7
CITY_LAT=43.238949
CITY_LNG=76.889709
CITY_NAME=Almaty
# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# MQTT subscriber for MQ-135 ESP8266 packets.
MQTT_ENABLED=true
MQTT_BROKER_URL=mqtt://broker.hivemq.com:1883
MQTT_CLIENT_ID=aua-backend-mq135
MQ135_TOPIC=almaty/auezov/mkr12/station1/air

# The physically built MQ-135 station. Its MQTT payload carries no coordinates,
# so where it hangs is configuration: without this it cannot be placed on the
# map or take part in the spatial interpolation.
MQ135_DEVICE_ID=aua-mq135-auezov-1
MQ135_DEVICE_NAME=Ауэзов мкр-12 · MQ-135
MQ135_DEVICE_DISTRICT=Ауэзов (12 мкр)
MQ135_LAT=43.2205
MQ135_LNG=76.834

# HMAC secrets used to authenticate device ingest (POST /api/ingest).
# Format: comma-separated id:secret pairs. Without this, all ingest returns 401.
# DEVICE_SECRETS=device-01:replace-with-long-random-secret,device-02:another-secret

# Bearer token guarding admin/mock endpoints (calibrate, /api/mock/*).
# If unset, those endpoints fail closed (401). Use a long random value.
# ADMIN_TOKEN=replace-with-long-random-admin-token

# OpenAQ v3 key — aggregates national reference networks (Kazhydromet among
# them). With it, /api/accuracy compares us against real monitoring stations.
# Without it the archive falls back to the Open-Meteo model and the UI says so
# explicitly, because agreeing with a model is not the same as being accurate.
# Free key at https://explore.openaq.org/register
# OPENAQ_KEY=your-openaq-api-key
# REFERENCE_REFRESH_MS=1800000

# TomTom Traffic Flow API key — enables LIVE traffic on the map and in air calc.
# Free tier at https://developer.tomtom.com (2500 req/day, no card). Without it,
# the traffic layer falls back to the synthetic Almaty model automatically.
# TOMTOM_KEY=your-tomtom-api-key
# TRAFFIC_REFRESH_MS=120000
